<resources>
    <!-- Estilos reutilizables para no repetir los mismos atributos en cada vista -->

    <!--
        Cuadro de color con una letra en medio.
        Los margenes van por separado y no con layout_margin, porque layout_margin
        tiene prioridad y anularia un marginStart o marginTop puesto en el XML.
    -->
    <style name="Caja">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/blanco</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Igual que Caja, pero su tamano se ajusta al texto (para textos largos) -->
    <style name="CajaTexto" parent="Caja">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">6dp</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- Titulo de cada ejemplo -->
    <style name="Seccion">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Texto que explica el layout al inicio de cada pantalla -->
    <style name="Descripcion">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
